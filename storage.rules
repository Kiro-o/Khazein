rules_version = '2';

// Khazeen - Cloud Storage rules.
// Product images are uploaded by the supplier web app to
// products/{supplierUid}/{timestamp}_{fileName}. Apps show them through
// download URLs (which carry their own token), so reads only need sign-in.
service firebase.storage {
  match /b/{bucket}/o {

    function isActiveSupplier(uid) {
      return request.auth != null &&
        request.auth.uid == uid &&
        firestore.get(/databases/(default)/documents/suppliers/$(uid)).data.status == 'active';
    }

    match /products/{supplierUid}/{fileName} {
      allow read: if request.auth != null;

      // Images only, up to 5 MB, in the uploader's own folder.
      allow create, update: if isActiveSupplier(supplierUid) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if isActiveSupplier(supplierUid);
    }

    // Store photos taken at merchant registration. Only the merchant (and
    // admins via the console) can see them.
    match /users/{uid}/store/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null &&
        request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider == 'phone' &&
        fileName in ['exterior.jpg', 'interior.jpg'] &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp)');

      allow delete: if false;
    }

    // Everything else is denied.
  }
}
